{
  // Cloudflare Workers static-assets deployment for the Vite build in ./dist
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pay-parking",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // any unknown path (e.g. a deep link to a ticket/payment QR page) serves index.html so the app can route it
    "not_found_handling": "single-page-application"
  }
}
